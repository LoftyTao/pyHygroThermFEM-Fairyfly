include CMakeLists.txt
include build_source.py
include _source_freeze.json
include LICENSE
include README.md
include README.zh-CN.md
include requirements.txt
include dev-requirements.txt
include pyproject.toml
graft bindings
graft pyhygrothermfem_fairyfly
exclude pyhygrothermfem_fairyfly/_build_source.json
graft vendor
graft patches
graft tests
graft docs
prune build
prune dist
prune vendor/KeffCavity/.git
prune vendor/KeffCavity/build
prune vendor/HygroThermFEM/build
prune vendor/LBNLCPPCommon/.git
prune vendor/LBNLCPPCommon/build
prune vendor/eigen/.git
prune vendor/eigen/build
prune vendor/Windows-CalcEngine/.git
prune vendor/Windows-CalcEngine/build
global-exclude .git
global-exclude *.py[cod]
global-exclude *.pyd *.dll *.so *.a *.lib *.obj *.pdb *.exe
