From 31ef1e07be68a7659a095f7b54ec2d9724d646bf Mon Sep 17 00:00:00 2001
From: Lofty Tao <178095221+LoftyTao@users.noreply.github.com>
Date: Tue, 29 Sep 2026 19:01:20 +0800
Subject: [PATCH 3/6] fix: index transient BC tables cyclically by declared
 period

forEachActiveBC indexed m_TransientBCs by the raw timestep index, forcing
callers to expand every periodic boundary series to num_steps entries (and
leaving an off-by-one: size() < timestepIndex let index == size read out
of bounds). Boundary series are periodic, so index cyclically
(timestepIndex % size); a table now needs only one entry per declared
period, keeping per-edge memory bounded on long runs.
---
 src/boundary/BoundaryConditions2D.hxx | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/boundary/BoundaryConditions2D.hxx b/src/boundary/BoundaryConditions2D.hxx
index c6736ba..1d16a7c 100644
--- a/src/boundary/BoundaryConditions2D.hxx
+++ b/src/boundary/BoundaryConditions2D.hxx
@@ -89,6 +89,13 @@ namespace HygroThermFEM
     private:
         //! Iterates over all active BCs (steady-state + transient at timestepIndex)
         //! and calls func(const IBCLinear2D &) for each.
+        //!
+        //! A transient BC table holds one entry per period of its coefficient
+        //! series (the binding supplies compact periodic series), so the table
+        //! indexes cyclically: step t uses entry t % size. This keeps per-edge
+        //! memory proportional to the declared period instead of the number of
+        //! timesteps, which matters for long runs (e.g. year-long hourly
+        //! sequences driven by a short periodic signal).
         template<typename Func>
         void forEachActiveBC(size_t timestepIndex, Func func) const
         {
@@ -98,13 +105,12 @@ namespace HygroThermFEM
             }
             for(const auto & bcTimesteps : m_TransientBCs)
             {
-                if(bcTimesteps.size() < timestepIndex)
+                if(bcTimesteps.empty())
                 {
                     throw std::runtime_error(
-                      "Number of boundary conditions provided is less then "
-                      "number of timesteps requested.");
+                      "Transient boundary condition tables cannot be empty.");
                 }
-                func(*bcTimesteps[timestepIndex]);
+                func(*bcTimesteps[timestepIndex % bcTimesteps.size()]);
             }
         }
     };
-- 
2.55.0.windows.2


