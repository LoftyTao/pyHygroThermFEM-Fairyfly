@@ -397,61 +397,57 @@ namespace HygroThermFEM
 
     std::vector<NodeFlux> IElementLinear2D::flux() const
     {
-        // Every registered term adds to the one flux of the element: the vapour and the
-        // liquid flux of the moisture element are one water flux. Each term differentiates
-        // the potential it transports, the state scaled by its nodal factor when it has one.
+        const auto gaussFlux = fluxAtGaussPoints();
+        // Invert the 2x2 Gauss shape-function matrix. Each corner consumes all
+        // four integration-point vectors, after transport contributions sum.
+        constexpr double a = 1.0 + std::numbers::sqrt3 / 2.0;
+        constexpr double b = -0.5;
+        constexpr double c = 1.0 - std::numbers::sqrt3 / 2.0;
+        constexpr std::array<std::array<double, 4>, 4> extrapolation{
+          {{a, b, c, b}, {b, a, b, c}, {c, b, a, b}, {b, c, b, a}}};
+        std::vector<NodeFlux> results(numOfQuadrilateralNodes, {0.0, 0.0});
+        for(std::size_t corner = 0; corner < numOfQuadrilateralNodes; ++corner)
+        {
+            for(std::size_t point = 0; point < gaussFlux.size(); ++point)
+            {
+                results[corner].x += extrapolation[corner][point] * gaussFlux[point].x;
+                results[corner].y += extrapolation[corner][point] * gaussFlux[point].y;
+            }
+        }
+        return results;
+    }
+
+    std::vector<NodeFlux> IElementLinear2D::fluxAtGaussPoints() const
+    {
         const auto state = m_Nodes.properties(m_FluxVariable);
-        std::vector<NodeFlux> results(numOfQuadrilateralNodes, NodeFlux{0.0, 0.0});
+        const auto & localElement = QuadrilateralLinearLocal2D::Instance();
+        const auto count = IntegrationPoints2D::Instance().count2D();
+        std::vector<NodeFlux> result(count, {0.0, 0.0});
         for(const auto & term : m_ConductanceFunctions)
         {
+            const auto coefficients = term.coefficient->values(m_Nodes);
             auto potential = state;
             if(term.nodalFactor != nullptr)
             {
-                const auto factors = term.nodalFactor->values(m_Nodes);
-                for(size_t nodeIdx = 0u; nodeIdx < numOfQuadrilateralNodes; ++nodeIdx)
+                const auto factor = term.nodalFactor->values(m_Nodes);
+                for(std::size_t node = 0; node < potential.size(); ++node)
                 {
-                    potential[nodeIdx] *= factors[nodeIdx];
+                    potential[node] *= factor[node];
                 }
             }
             const auto gradients = gradientsAtGaussPoints(potential);
-            const auto conductivityValues = term.coefficient->values(m_Nodes);
-            assert(conductivityValues.size() == numOfQuadrilateralNodes);
-
-            // Extrapolate flux from 2x2 Gauss points to corner nodes using the
-            // standard bilinear extrapolation matrix.  Coefficients derive from
-            // evaluating the Gauss-point shape functions at the corner nodes:
-            //   A = 1 + sqrt(3)/2,  B = -1/2,  C = 1 - sqrt(3)/2
-            constexpr auto gaussToNodeA = 1.866025404;
-            constexpr auto gaussToNodeB = -0.5;
-            constexpr auto gaussToNodeC = 0.133974596;
-            const std::vector<std::vector<double>> extrapolationCoefficients{
-              {gaussToNodeA, gaussToNodeB, gaussToNodeC, gaussToNodeB},
-              {gaussToNodeB, gaussToNodeA, gaussToNodeB, gaussToNodeC},
-              {gaussToNodeC, gaussToNodeB, gaussToNodeA, gaussToNodeB},
-              {gaussToNodeB, gaussToNodeC, gaussToNodeB, gaussToNodeA}};
-
-            for(size_t nodeIdx = 0u; nodeIdx < numOfQuadrilateralNodes; ++nodeIdx)
+            for(std::size_t point = 0; point < count; ++point)
             {
-                for(const auto coeff : extrapolationCoefficients[nodeIdx])
+                const auto & psi = localElement.Psi(point);
+                double coefficient{0.0};
+                for(std::size_t node = 0; node < coefficients.size(); ++node)
                 {
-                    results[nodeIdx].x -= conductivityValues[nodeIdx] * gradients[nodeIdx][0] * coeff;
-                    results[nodeIdx].y -= conductivityValues[nodeIdx] * gradients[nodeIdx][1] * coeff;
+                    coefficient += psi[node] * coefficients[node];
                 }
+                result[point].x -= coefficient * gradients[point][0];
+                result[point].y -= coefficient * gradients[point][1];
             }
         }
-        return results;
-    }
-
-    std::vector<NodeFlux> IElementLinear2D::fluxAtGaussPoints() const
-    {
-        const auto gradients = stateGradientsAtGaussPoints();
-        const auto cond = meanConductivity();
-        std::vector<NodeFlux> result;
-        result.reserve(gradients.size());
